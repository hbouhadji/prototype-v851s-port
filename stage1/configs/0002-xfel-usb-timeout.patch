+/* Long-running SRAM memory tests need more than the default ten seconds. */
+static unsigned ram_test_usb_timeout(void)
+{
+    const char *value = getenv("XFEL_USB_TIMEOUT_MS");
+    unsigned timeout = value ? (unsigned)strtoul(value, NULL, 10) : 10000;
+    return timeout >= 1000 && timeout <= 120000 ? timeout : 10000;
+}
 
